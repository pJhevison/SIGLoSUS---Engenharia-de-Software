    NODE -->|"HTTPS / JSON (Adapter)"| BNAFAR

    classDef cli fill:#e0f2fe,stroke:#0369a1,color:#0c4a6e;
    classDef srv fill:#dcfce7,stroke:#15803d,color:#14532d;
    classDef rede fill:#fee2e2,stroke:#b91c1c,color:#7f1d1d;
