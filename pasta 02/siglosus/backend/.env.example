# ==========================================================================
# SIGLoSUS — variáveis de ambiente do backend
# Copie para ".env" (ajustando os valores) e ajuste o ".gitignore".
# ==========================================================================

# Ambiente de execução: development | test | production
NODE_ENV=development

# Porta da API
PORT=3000

# Segredo usado para assinar os tokens JWT (OBRIGATÓRIO em produção).
# Gere um valor aleatório com, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio-de-no-minimo-32-caracteres

# Validade do token de acesso (minutos)
TOKEN_ACESSO_VALIDADE_MIN=60

# Validade do token temporário de recuperação de senha (minutos)
TOKEN_RECUPERACAO_VALIDIDADE_MIN=30

# Fator de custo do bcrypt (10 = 2^10 iterações; 4 apenas para testes)
BCRYPT_COST=10

# Origens permitidas no CORS (separadas por vírgula). Vazio = lista padrão local.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Limite de tentativas de login por minuto e por endereço IP
LIMITE_LOGIN_POR_MINUTO=10

# Limite de valor (R$) acima do qual a requisição exige aprovação do gestor (RN09)
LIMITE_APROVACAO_GESTOR=5000

# Validade mínima (dias) dos lotes transferíveis entre unidades (RN03)
VALIDADE_MINIMA_TRANSFERENCIA_DIAS=90

# Arquivo de persistência do estado do protótipo.
# Deixe vazio para manter os dados somente em memória.
# Exemplo: SIGLOSUS_ARQUIVO_PERSISTENCIA=./data/siglosus.json
SIGLOSUS_ARQUIVO_PERSISTENCIA=
