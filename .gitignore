# ------------------------------------------------------------------
# SIGLoSUS — arquivos ignorados pelo Git (.gitignore)
# ------------------------------------------------------------------

# Dependências
node_modules/
jspm_packages/
.pnp
.pnp.js

# Build / artefatos gerados
dist/
build/
out/
*.tsbuildinfo

# Cobertura de testes
coverage/
.nyc_output/

# Variáveis de ambiente e segredos
.env
.env.*
!.env.example
*.pem
*.key

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Editores / IDEs
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# Cache de ferramentas
.cache/
.eslintcache
.npm/
